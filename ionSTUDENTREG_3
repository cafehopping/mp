import { Component } from '@angular/core';
import { IonHeader, IonToolbar, IonTitle, IonContent, IonItem, IonInput, IonButton, IonRadio, IonRadioGroup } from '@ionic/angular/standalone';
import { FormsModule } from '@angular/forms';

import { NavController } from '@ionic/angular/standalone';
@Component({
  selector: 'app-home',
  templateUrl: 'home.page.html',
  styleUrls: ['home.page.scss'],
  imports: [IonHeader, IonToolbar, IonTitle, IonContent, IonItem, IonInput, IonButton, IonRadio, IonRadioGroup, FormsModule]

})
export class HomePage {
  name: string = '';
  rollno: string = '';
  course: string = '';
  gender: string = '';
  constructor(private navCtrl: NavController) {}
  goToDetail() {
    this.navCtrl.navigateForward('/display', {
      state: {
        name: this.name,
        rollno: this.rollno,
        course: this.course,
        gender: this.gender
      }
    });
  }
}
