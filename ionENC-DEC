import { Component } from 
'@angular/core';
import { FormsModule } from 
'@angular/forms';
import { 
  IonHeader, 
  IonToolbar, 
  IonTitle, 
  IonContent, 
  IonCard, 
  IonCardHeader, 
  IonCardTitle, 
  IonCardContent, 
  IonItem, 
  IonInput, 
  IonTextarea, 
  IonButton } from '@ionic/angular';
@Component({
  selector: 'app-home', 
  templateUrl: 'home.page.html', 
  styleUrls: ['home.page.scss'], 
  standalone:true, 
  imports: [ 
    FormsModule, 
    IonHeader, 
    IonToolbar, 
    IonTitle, 
    IonContent, 
    IonCard, 
    IonCardHeader, 
    IonCardTitle, 
    IonCardContent, 
    IonItem, 
    IonInput, 
    IonTextarea, 
    IonButton 
  ] 
})
export class HomePage {
  text: string = '';
  key: string = '';
  result: string = '';
  encrypt() {
    if (!this.text || !this.key) {
      this.result = 'Please enter text and key';
      return;
    }
    this.result = this.processText(this.text, this.key, true);
  }
  decrypt() {
    if (!this.text || !this.key) {
      this.result = 'Please enter text and key';
      return;
    }
    this.result = this.processText(this.text, this.key, false);
  }
  processText(input: string, key: string, isEncrypt: boolean): string {
    let output = '';
    const shift = key.length;
    for (let i = 0; i < input.length; i++) {
      let ch = input.charAt(i);
      if (this.isAlpha(ch)) {
        let code = ch.charCodeAt(0);
        if (isEncrypt) {
          code = code + shift;
        } else {
          code = code - shift;
        }
        output += String.fromCharCode(code);
      } else {
        output += ch;
      }
    }
    return output;
  }
  isAlpha(ch: string): boolean {
    return /^[a-zA-Z]$/.test(ch);
  }
  clearAll() {
    this.text = '';
    this.key = '';
    this.result = '';
  }
}
