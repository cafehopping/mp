import { Component } from '@angular/core'; 
import 	{ IonHeader, IonToolbar, IonTitle, IonContent, IonItem, IonInput, IonButton} 	from '@ionic/angular/standalone'; 
import { FormsModule } from '@angular/forms'; 
import { NavController } from '@ionic/angular/standalone'; 
@Component({ 
  selector: 'app-home',   templateUrl: 'home.page.html',   styleUrls: ['home.page.scss'], 
  imports: [IonHeader, IonToolbar, IonTitle, IonContent, IonItem, IonInput, IonButton, FormsModule] 
}) 
export class HomePage {   name: string = '';   marks1: number | null = null;   marks2: number | null = null;   marks3: number | null = null;   marks4: number | null = null;   marks5: number | null = null; 
  constructor(private navCtrl: NavController) {}   calculateResult() { 
    let total = 
      Number(this.marks1) + 
      Number(this.marks2) + 
      Number(this.marks3) + 
      Number(this.marks4) +       Number(this.marks5); 
    let percentage = (total / 500) * 100; 
    let result: string;     let grade: string; 
    if (Number(this.marks1) < 35 || Number(this.marks2) < 35 || Number(this.marks3) < 35 || Number(this.marks4) 
< 35 || Number(this.marks5) < 35) { 
      result = 'FAIL';       grade = 'F';     } else {       result = 'PASS';       if (percentage >= 75) { 
        grade = 'A'; 
      } 
      else if (percentage >= 60) { 
        grade = 'B'; 
      } 
      else if (percentage >= 50) { 
        grade = 'C'; 
      } 
      else {         grade = 'D'; 
      } 
    } 
    this.navCtrl.navigateForward('/display', {  
    state: {         
    name: this.name,         
    marks1 this.marks1,         
    marks2: this.marks2,         
    marks3: this.marks3,         
    marks4: this.marks4,         
    marks5: this.marks5,         
    total: total,         
    percentage: percentage, 
    result: result, 
    grade: grade 
    } 
   }); 
} } 




