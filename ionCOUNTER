import { Component } from '@angular/core';
import {IonHeader, IonToolbar, IonTitle, IonContent, IonCard, IonCardHeader, IonCardTitle, IonCardContent, IonButton } from '@ionic/angular/standalone';
@Component({
  selector: 'app-home',
  templateUrl: 'home.page.html',
  styleUrls: ['home.page.scss'],
  standalone: true,
  imports: [ IonHeader, IonToolbar, IonTitle, IonContent, IonCard, IonCardHeader, IonCardTitle,
  IonCardContent, IonButton ]
})
export class HomePage {
  count: number = 0;
  increment(): void {
    this.count++;
  }
  decrement(): void {
    this.count--;
  }
  reset(): void {
    this.count = 0;
  }
}
